      "kind": "number",
      "dimension": "pressure",
      "optional": true,
      "disabled_by_default": true,
      "enable_as": "Tire pressure rear left"
    },
    "tire_psi_rr": {
      "entity": "sensor.{slug}_tire_pressure_rear_right",
      "kind": "number",
      "dimension": "pressure",
      "optional": true,
      "disabled_by_default": true,
      "enable_as": "Tire pressure rear right"
    },
    "tire_warn_fl": {
      "entity": "binary_sensor.{slug}_tire_pressure_warning_front_left",
      "kind": "on_off",
      "optional": true,
      "disabled_by_default": true,
      "enable_as": "Tire pressure warning front left"
